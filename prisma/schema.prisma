generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum ProductType {
  MODULE
  FULL_COURSE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  avatarUrl     String?
  isSuspended   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments        Enrollment[]
  moduleEnrollments  ModuleEnrollment[]
  progress           Progress[]
  projectProgress    ProjectProgress[]
  payments           Payment[]
  certificates       Certificate[]
  sessions           Session[]
  accounts           Account[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Int      // in cents (ARS)
  currency    String   @default("ARS")
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  certificates Certificate[]
  products    Product[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String   @db.Text
  order       Int
  price       Int      // in cents (ARS)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons            Lesson[]
  project            Project?
  tools              Tool[]
  products           Product[]
  moduleEnrollments  ModuleEnrollment[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?  @db.Text
  content     String   @db.Text // JSON or Markdown content
  order       Int
  status      Status   @default(ACTIVE)
  durationMin Int?     // estimated minutes
  unlockToolId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]
  tools       Tool[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  url         String?
  imageUrl    String?
  moduleId    String?
  lessonId    String?
  instructions String? @db.Text
  status      Status   @default(ACTIVE)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([moduleId])
  @@index([lessonId])
}

model Project {
  id           String   @id @default(cuid())
  moduleId     String   @unique
  title        String
  description  String   @db.Text
  objective    String?  @db.Text
  resultFinal  String?  @db.Text
  requirements String?  @db.Text
  steps        String?  @db.Text // JSON
  resources    String?  @db.Text // JSON
  checklist    String?  @db.Text // JSON
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     ProjectProgress[]
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model ProjectProgress {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  completed   Boolean  @default(false)
  completedAt DateTime?
  submission  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
}

model Product {
  id          String      @id @default(cuid())
  code        String      @unique // MODULE_1, FULL_COURSE, etc.
  name        String
  description String?     @db.Text
  type        ProductType
  price       Int         // cents
  currency    String      @default("ARS")
  moduleId    String?
  courseId    String?
  status      Status      @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  module      Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([code])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(PENDING)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

/**
 * Acceso comercial a un módulo individual.
 * FULL_COURSE → Enrollment ACTIVE (todos los módulos).
 * MODULE_N   → ModuleEnrollment ACTIVE solo para ese módulo.
 */
model ModuleEnrollment {
  id          String           @id @default(cuid())
  userId      String
  moduleId    String
  paymentId   String?
  status      EnrollmentStatus @default(ACTIVE)
  startsAt    DateTime         @default(now())
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@index([paymentId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  productId         String
  provider          String        @default("mercadopago")
  externalPaymentId String?
  amount            Int           // cents
  currency          String        @default("ARS")
  status            PaymentStatus @default(PENDING)
  metadata          String?       @db.Text // JSON
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  moduleEnrollments ModuleEnrollment[]

  @@index([userId])
  @@index([externalPaymentId])
  @@index([status])
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([certificateCode])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Registro de acciones del administrador (auditoría simple)
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String   // GRANT_MODULE | REVOKE_MODULE | GRANT_FULL | REVOKE_FULL | SUSPEND | UNSUSPEND
  details      String?  @db.Text // JSON
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}
